# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL Management API первого Outline-сервера (опционально — только для первого запуска)
# При первом старте автоматически мигрирует в servers.json
# Дальнейшее управление серверами — через кнопку "➕ Добавить сервер" в боте
# Найти: Outline Manager → Настройки → URL для доступа к Management API
OUTLINE_API_URL=https://YOUR_SERVER_IP:PORT/YOUR_SECRET_PATH

# Telegram ID администраторов через запятую (узнать у @userinfobot)
ALLOWED_IDS=123456789,987654321

# Префикс для автоимени при быстром создании ключа (по умолчанию: Key)
# Ключи будут называться: "Key #1", "Key #2" и т.д.
# Можно изменить в боте через ⚙️ Сервер → 🏷 Префикс (до перезапуска)
KEY_PREFIX=Key
